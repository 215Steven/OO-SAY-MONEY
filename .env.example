# 部署於 Vercel：以下環境變數需在 Vercel Dashboard → Settings → Environment Variables 設定
# 本機開發：複製為 .env 並填入值

# --- LINE ---
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_RICH_MENU_ID_6=

# --- Notion ---
NOTION_API_KEY=
NOTION_DATABASE_ID_MEMBERS=
NOTION_DATABASE_ID_RESERVATIONS=
NOTION_DATABASE_ID_INSURANCE=

# --- 管理端點（/api/admin/*）存取密鑰，自行產生一組隨機字串；未設定時管理端點一律拒絕 ---
ADMIN_TOKEN=
