# ── Gemini AI ────────────────────────────────────────
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
APP_URL="YOUR_APP_URL"

# ── LINE LIFF ─────────────────────────────────────────
# LINE Developer Console → Your Channel → LIFF → LIFF ID
VITE_LIFF_ID="YOUR_LIFF_ID_HERE"

# ── Telegram Bot（預約通知）───────────────────────────
# 1. 找 @BotFather 建 bot → 取得 token
# 2. 把 bot 加進群組或直接私訊 → 取得 chat_id
VITE_TG_BOT_TOKEN="YOUR_BOT_TOKEN_HERE"
VITE_TG_CHAT_ID="YOUR_CHAT_ID_HERE"

# ── Make.com Webhook（預約 → Notion）────────────────
# Make.com → 建立 scenario → Webhook trigger → 複製 URL
VITE_MAKE_WEBHOOK="YOUR_MAKE_WEBHOOK_URL"

# ── Notion API（Netlify Function 用，不要加 VITE_ 前綴）
# Notion → Settings → Integrations → New integration → Token
NOTION_TOKEN="secret_xxxxxxxxxxxxxxxx"
# 🛡️ 家庭保障記錄 database ID
COVERAGE_DB_ID="9cefb2321c8e47989a00b85a4a3b53b6"
